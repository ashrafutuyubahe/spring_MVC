<!--        <servlet-name>viewPatient</servlet-name>-->
<!--        <jsp-file>/viewPatient.jsp</jsp-file>-->
<!--    </servlet>-->
<!--    <servlet-mapping>-->
<!--        <servlet-name>viewPatient</servlet-name>-->
<!--        <url-pattern>/view</url-pattern>-->
<!--    </servlet-mapping>-->

    <servlet>
        <servlet-name>ManagePatientsController</servlet-name>
        <servlet-class>com.example.clinic_mng_app.Controller.ManagePatientsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManagePatientsController</servlet-name>
        <url-pattern>/view</url-pattern>
    </servlet-mapping>


    <welcome-file-list>
        <welcome-file>welcome.jsp</welcome-file>
    </welcome-file-list>

</web-app>

